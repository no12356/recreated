---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Vhs!Sans has spawned")
end)

entity:SetCallback("OnStartMoving", function()
	print("Vhs!Sans has started moving")
end)

entity:SetCallback("OnReachNode", function(node)
	print("Vhs!Sans has reached node:", node)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("Vhs!Sans has entered room: ".. room.Name.. " for the first time")
	else
		print("Vhs!Sans has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at Vhs!Sans")
	else
		print("Player view is obstructed from Vhs!Sans")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("Vhs!Sans has started rebounding")
	else
		print("Vhs!Sans has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Vhs!Sans is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Vhs!Sans has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Vhs!Sans has killed the player")
	else
		print("Vhs!Sans has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run()

