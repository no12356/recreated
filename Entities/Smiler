---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Smiler has spawned")
end)

entity:SetCallback("OnStartMoving", function()
	print("Smiler has started moving")
end)

entity:SetCallback("OnReachNode", function(node)
	print("Smiler has reached node:", node)
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("Smiler has entered room: ".. room.Name.. " for the first time")
	else
		print("Smiler has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at Smiler")
	else
		print("Player view is obstructed from Smiler")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("Smiler has started rebounding")
	else
		print("Smiler has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Smiler is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Smiler has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Smiler has killed the player")
	else
		print("Smiler has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run()

